(* ::Package:: *)

(* Buffering.wl -- Okada-Mochizuki buffering structures.

   A pair (m,r) of a species subset m and a reaction subset r is a
   buffering structure (Okada & Mochizuki, PRL 117, 048101, 2016) if:
   (i)  output-complete: no reaction outside r has a reactant in m;
   (ii) lam(m,r) := rank(gamma[[All,r]]) - Length[m] == 0, where gamma is
        the NET stoichiometric matrix restricted to ALL species rows and
        only the columns r.

   For a given m, the SMALLEST r making (m,r) output-complete is forced:
   r = reactions with a reactant in m (via alp, the reactant matrix from
   extMat). Enlarging r beyond this can only raise rank(gamma[[All,r]]),
   never lower it, so this forced r is also the one most likely to give
   lam==0; we do not search over larger r.

   Reuses extMat (unchanged) for alp (reactant matrix) and gamma (net
   stoichiometric matrix). Does not touch minSiph or NGM. *)

(* buffS[RN] -> {mBuffS,allBuffS}: brute-force over all nonempty species
   subsets m (2^n, n=species count -- fine up to ~15-18 species). *)
buffS[RN_List] := Module[
  {spe, alp, bet, gamma, n, m, mIdx, rSet, rk, lam, found, allBuffS, mBuffS},
  {spe, alp, bet, gamma} = extMat[RN][[1 ;; 4]];
  n = Length[spe];
  m = Length[First[gamma]];
  found = Reap[
    Do[
      rSet = Flatten[Position[Total[alp[[mIdx]]], _?Positive]];
      If[Length[rSet] >= Length[mIdx],
        rk = MatrixRank[gamma[[All, rSet]]];
        lam = rk - Length[mIdx];
        If[lam == 0, Sow[{spe[[mIdx]], RN[[rSet]]}]]
      ],
      {mIdx, Subsets[Range[n], {1, n}]}
    ]
  ][[2]];
  allBuffS = If[found === {}, {}, First[found]];
  mBuffS = Select[allBuffS,
    Function[b, AllTrue[allBuffS,
      Function[b2, b2 === b || !SubsetQ[b[[1]], b2[[1]]]]]]];
  {mBuffS, allBuffS}
];

(* isOutC[RN,m,r] -> True/False: output-complete iff every reaction whose
   reactant intersects m lies in r (reactant incidence, not net
   stoichiometry -- catches e.g. Ik->Ik+Pk, invisible in gamma). *)
isOutC[RN_List, m_List, r_List] := Module[{forced},
  forced = Select[RN, Intersection[Keys[comp2Asso[#[[1]]]], m] =!= {} &];
  SubsetQ[r, forced]
];

(* locIdx[RN,m,r] -> integer: rank(gamma[[All,rCols]]) - Length[m], using
   ALL species rows of gamma (never only m's rows). *)
locIdx[RN_List, m_List, r_List] := Module[{spe, alp, bet, gamma, rIdx},
  {spe, alp, bet, gamma} = extMat[RN][[1 ;; 4]];
  rIdx = Flatten[Position[RN, #, {1}, 1] & /@ r];
  MatrixRank[gamma[[All, rIdx]]] - Length[m]
];

isBuff[RN_List, m_List, r_List] := isOutC[RN, m, r] && locIdx[RN, m, r] == 0;

(* allBuff[RN] -> list of {m,r} buffering structures, general form of
   buffS: for each candidate m (Exhaustive: all nonempty subsets;
   ERCGenerated: species closures generated by joins of ERCs from
   Organizations.wl), uses the forced minimal r and tests isBuff. *)
Options[allBuff] = {Method -> "Exhaustive"};
allBuff[RN_List, OptionsPattern[]] := Module[{spe, cands, pairs, ercs},
  spe = extSpe[RN];
  cands = If[OptionValue[Method] === "ERCGenerated",
    ercs = allErc[RN][[All, 2]];
    DeleteDuplicates[speClo[RN, Union @@ #] & /@ Subsets[ercs, {1, Length[ercs]}]],
    Union /@ Subsets[spe, {1, Length[spe]}]
  ];
  pairs = Function[m, {m, Select[RN, Intersection[Keys[comp2Asso[#[[1]]]], m] =!= {} &]}] /@ cands;
  Select[pairs, isBuff[RN, #[[1]], #[[2]]] &]
];

(* bufferBifurcationTest[RN,odes,vars,pars] -> list of per-candidate-buffer
   results (one entry per (m,r) from allBuff[RN]), each entry a flat list
   {m,r,outC,lam,tri,intJ,hurwCond,uIndep,detJDepPars,verdict}:
     m,r        - buffer species/reactions (as returned by allBuff)
     outC,lam   - output-completeness, localization index (isOutC,locIdx)
     tri        - dynamic triangularity: D[uEq,{vVars}] is identically 0,
                  where u=vars\m, v=m (Definition d:dynamic-buffer (i))
     intJ       - internal Jacobian D[vEq,{vVars}] (block D_vg)
     hurwCond   - Hurwitz conditions on intJ: {tr<0,det>0} if |m|<=2, else
                  Routh-Hurwitz NECESSARY sign conditions on the char. poly
                  coefficients (sufficient only up to size 2 -- for |m|>2
                  the caller must still check via Reduce)
     uIndep     - True iff the u-block characteristic polynomial does not
                  depend on the buffer's own parameters (params appearing
                  in vEq) -- confirms condition (i) at the parameter level
     detJDepPars - whether det(full Jacobian) depends on the buffer params
                  (diagnostic only, not part of the verdict)
     verdict    - one of "SteadyStateLocalizationOnly",
                  "DynamicTriangularBuffer", "CandidateBifurcationParameter",
                  "Inconclusive" (the Hopf/zero-eigenvalue-exclusion
                  verdicts "ZeroEigenvalueBifurcationExcluded" and
                  "HopfBifurcationExcluded" follow from "DynamicTriangularBuffer"
                  once hurwCond is confirmed by Reduce for |m|>2) *)
bufferBifurcationTest[RN_List, odes_List, vars_List, pars_List] := Module[
  {cands, results},
  cands = allBuff[RN];
  results = Function[cand, Module[
    {m, r, outC, lam, mIdx, uIdx, uVars, vVars, uEq, vEq, tri, intJ, buffPars,
     hurwCond, detJ, detJDepPars, uCharCoeffs, uIndep, verdict, x},
    {m, r} = cand;
    outC = isOutC[RN, m, r];
    lam = locIdx[RN, m, r];
    mIdx = Flatten[Position[SymbolName /@ vars, #] & /@ m];
    uIdx = Complement[Range[Length[vars]], mIdx];
    vVars = vars[[mIdx]];
    uVars = vars[[uIdx]];
    uEq = odes[[uIdx]];
    vEq = odes[[mIdx]];
    tri = AllTrue[Flatten[D[uEq, {vVars}]], PossibleZeroQ];
    intJ = D[vEq, {vVars}];
    buffPars = Intersection[pars, Variables[vEq]];
    hurwCond = Which[
      Length[vVars] == 0, {},
      Length[vVars] == 1, {intJ[[1, 1]] < 0},
      Length[vVars] == 2, {Tr[intJ] < 0, Det[intJ] > 0},
      True, Rest[CoefficientList[CharacteristicPolynomial[-intJ, x], x]]
    ];
    uCharCoeffs = If[tri && Length[uVars] > 0,
      CoefficientList[CharacteristicPolynomial[D[uEq, {uVars}], x], x], {}];
    uIndep = If[tri && Length[uVars] > 0,
      AllTrue[Flatten[D[uCharCoeffs, {buffPars}]], PossibleZeroQ], tri];
    detJ = Det[D[odes, {vars}]];
    detJDepPars = !AllTrue[Flatten[D[detJ, {buffPars}]], PossibleZeroQ];
    verdict = Which[
      !outC || lam != 0, "Inconclusive",
      Length[uVars] == 0, "SteadyStateLocalizationOnly",
      tri && uIndep, "DynamicTriangularBuffer",
      tri && !uIndep, "CandidateBifurcationParameter",
      True, "SteadyStateLocalizationOnly"
    ];
    {m, r, outC, lam, tri, intJ, hurwCond, uIndep, detJDepPars, verdict}
  ]] /@ cands;
  results
];

(* bufLat[RN,spe] -> complete list of buffering structures {m,r}.  Unlike
   buffS/allBuff, r is not only the forced Out(m): any reaction whose net
   column lies in the span of gam[[All,Out(m)]] may be added (index stays 0),
   which is needed for inflows and for the full lattice (Prop. p:outSuff of
   the KTV tutorial).  Exhaustive over 2^n species subsets. *)
bufLat[RN_List, spe0_List : {}] := Module[{spe, alp, gam, n, nr, out, res = {}, r, rk, ext},
  {spe, alp, gam} = extMat[RN, spe0][[{1, 2, 4}]];
  n = Length[spe]; nr = Length[RN];
  If[MatrixRank[gam] < n, Return[{}]];
  out = Flatten[Position[#, _?Positive]] & /@ alp;
  Do[
    r = Union @@ Append[out[[mI]], {}];
    rk = If[r === {}, 0, MatrixRank[gam[[All, r]]]];
    If[rk == Length[mI],
      ext = Select[Complement[Range[nr], r], MatrixRank[gam[[All, Append[r, #]]]] == rk &];
      Do[AppendTo[res, {spe[[mI]], Sort[Join[r, x]]}], {x, Subsets[ext]}]],
    {mI, Subsets[Range[n]]}];
  res
];

(* latHas[lat] -> Hasse cover edges {i,j} of the inclusion order on {m,r}. *)
latHas[lat_List] := Module[{k = Length[lat], lt},
  lt[a_, b_] := a =!= b && SubsetQ[lat[[b, 1]], lat[[a, 1]]] && SubsetQ[lat[[b, 2]], lat[[a, 2]]];
  Select[Tuples[Range[k], 2],
    lt @@ # && NoneTrue[Range[k], Function[h, lt[#[[1]], h] && lt[h, #[[2]]]]] &]
];

(* latBlk[lat,cov] -> {blk,inf}: join-irreducibles give the CCF blocks
   (Birkhoff); block a moves block b when ideal(b) is strictly inside ideal(a). *)
latBlk[lat_List, cov_List] := Module[{irr, blk, prs},
  irr = Select[Range[Length[lat]], Count[cov[[All, 2]], #] == 1 &];
  blk = Function[j, With[{l = First[Select[cov, #[[2]] == j &]][[1]]},
      {j, Complement[lat[[j, 1]], lat[[l, 1]]], Complement[lat[[j, 2]], lat[[l, 2]]]}]] /@ irr;
  prs = Select[Tuples[Range[Length[irr]], 2], #[[1]] =!= #[[2]] &&
      SubsetQ[lat[[irr[[#[[1]]]], 2]], lat[[irr[[#[[2]]]], 2]]] &];
  {blk, If[prs === {}, {},
    List @@@ EdgeList[TransitiveReductionGraph[Graph[Range[Length[irr]], DirectedEdge @@@ prs]]]]}
];

(* rcMat[RN,spe] -> {L,dL,fL}: symbolic rate-cycle matrix and its factors. *)
rcMat[RN_List, spe0_List : {}] := Module[{spe, alp, gam, n, nr, T, ns, L, dL},
  {spe, alp, gam} = extMat[RN, spe0][[{1, 2, 4}]];
  n = Length[spe]; nr = Length[RN];
  If[MatrixRank[gam] < n, Return[{{}, Missing["rank"], {}}]];
  T = Table[If[alp[[i, j]] > 0, \[FormalT][j, i], 0], {j, nr}, {i, n}];
  ns = NullSpace[gam];
  L = If[ns === {}, T, Join[T, Transpose[ns], 2]];
  dL = TimeConstrained[Factor[Det[L]], 120, $Aborted];
  {L, dL, If[dL === $Aborted, {},
    Select[FactorList[dL][[All, 1]], !NumericQ[#] &]]}
];

(* locChk[RN,rts,var,m] -> True iff rows outside m of J^-1 gam[[All,Out(m)]]
   vanish at a random exact rational point. *)
locChk[RN_List, rts_List, var_List, m_List] := Module[{spe, gam, J, out, oth, vs, rul},
  spe = If[Head[#] === Symbol, SymbolName[#], ToString[#, InputForm]] & /@ var;
  gam = extMat[RN, spe][[4]];
  J = gam . D[rts, {var}];
  out = Select[Range[Length[RN]], Intersection[Keys[comp2Asso[RN[[#, 1]]]], m] =!= {} &];
  oth = Complement[Range[Length[var]], Flatten[Position[spe, #] & /@ m]];
  vs = Variables[{J, gam}];
  rul = Thread[vs -> RandomInteger[{1, 97}, Length[vs]]/RandomInteger[{1, 13}, Length[vs]]];
  AllTrue[Flatten[LinearSolve[J /. rul, gam[[All, out]]][[oth]]], # == 0 &]
];

(* ccfJl[Rpat,gam] -> {blk,ord,cov,C0,Cinf,R0T,RinfT} from LayeredMixedMatrices.jl
   (Kuhrs-Telek-Vassena), polynomial time, no 2^n loop.  Rpat: reactions x
   species 0/1 rate dependence (need not be mass action); gam: species x
   reactions net stoichiometry.  blk={{reactions},{species},{cycleRows}}. *)
ccfJl[Rpat_List, gam_List] := Module[{d = $TemporaryDirectory, f1, f2, f3, ns, C, p},
  {f1, f2, f3} = FileNameJoin[{d, #}] & /@ {"ccfR.tsv", "ccfC.tsv", "ccfOut.m"};
  Export[f1, Boole[Map[TrueQ[# =!= 0 && # =!= False] &, Rpat, {2}]], "TSV"];
  ns = NullSpace[gam];
  C = If[ns === {}, {}, Transpose[(LCM @@ Denominator[#]) # & /@ ns]];
  If[C === {}, Export[f2, "", "Text"], Export[f2, C, "TSV"]];
  p = RunProcess[{"julia", FileNameJoin[{$HomeDirectory, "Dropbox", "EpidCRNmodels", "ccfRun.jl"}], f1, f2, f3}];
  If[p["ExitCode"] =!= 0, Return[{$Failed, p["StandardError"]}]];
  Get[f3]
];

(* ccfRN[RN,spe] -> ccfJl with the mass-action pattern (rate depends on reactants). *)
ccfRN[RN_List, spe0_List : {}] := Module[{alp, gam},
  {alp, gam} = extMat[RN, spe0][[{2, 4}]];
  ccfJl[Transpose[Map[Boole[# > 0] &, alp, {2}]], gam]
];

(* ccfIdl[nb,ord,cap] -> order ideals of the CCF block poset (lists of block
   indices), i.e. the buffering structures; a pair {k,l} in ord means every
   ideal containing block k contains block l.  Stops at cap ideals. *)
ccfIdl[nb_Integer, ord_List, cap_Integer : 100000] := Module[{need, top, res = {{}}},
  need = Table[Cases[ord, {k, l_} /; l =!= k :> l], {k, nb}];
  top = TopologicalSort[Graph[Range[nb], DirectedEdge[#[[2]], #[[1]]] & /@ Select[ord, #[[1]] =!= #[[2]] &]]];
  Do[If[Length[res] < cap,
      res = Join[res, Append[#, k] & /@ Select[res, SubsetQ[#, need[[k]]] &]]], {k, top}];
  Sort /@ res
];

