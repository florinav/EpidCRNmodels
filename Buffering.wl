(* Visualizations of the buffering analysis: rnPlot (reaction graph with one
   buffering structure highlighted), latPlot (Hasse diagram of the lattice),
   blkPlot (canonical blocks and their influence arrows). *)
latLev[n_Integer, cov_List] := Module[{lev = ConstantArray[0, n], ch = True},
  While[ch, ch = False;
    Do[If[lev[[e[[2]]]] < lev[[e[[1]]]] + 1, lev[[e[[2]]]] = lev[[e[[1]]]] + 1; ch = True], {e, cov}]];
  lev];

hasPlot[n_Integer, cov_List, lab_, col_] := Module[{lev = latLev[n, cov], xy},
  xy = Table[With[{same = Flatten[Position[lev, lev[[k]]]]},
      {Position[same, k][[1, 1]] - (Length[same] + 1)/2, lev[[k]]}], {k, n}];
  Graph[Range[n], DirectedEdge @@@ cov, VertexCoordinates -> xy,
    VertexLabels -> Table[k -> Placed[Framed[lab[k], Background -> col, FrameStyle -> Gray,
        RoundingRadius -> 3, FrameMargins -> 2], Center], {k, n}],
    VertexSize -> 0, EdgeStyle -> Gray, BaseStyle -> {FontSize -> 9}, ImagePadding -> 12,
    ImageSize -> {UpTo[220], UpTo[45 (Max[lev] + 1)]}]];

latPlot[lat_List, cov_List] := hasPlot[Length[lat], cov,
  Column[{If[lat[[#, 1]] === {}, "\[EmptySet]", StringRiffle[ToString /@ lat[[#, 1]], ","]],
      Style["|R|=" <> ToString[Length[lat[[#, 2]]]], Gray]}, Alignment -> Center] &, White];

blkPlot[blk_List, inf_List] := Module[{g = hasPlot[Length[blk], Reverse /@ inf,
    Column[{If[blk[[#, 2]] === {}, "no species", StringRiffle[ToString /@ blk[[#, 2]], ","]],
        Style[ToString[Length[blk[[#, 3]]]] <> " reactions", Gray]}, Alignment -> Center] &, LightBlue]},
  Graph[g, EdgeStyle -> Directive[Red, Thick], EdgeShapeFunction -> ({Arrowheads[{{0.05, 0.6}}], Arrow[Reverse[#1]]} &)]];

rnPlot[RN_List, spe0_List : {}, br_List : {{}, {}}] := Module[{spe, alp, bet, nr, sv, rv, ed, m, r},
  {spe, alp, bet} = extMat[RN, spe0][[{1, 2, 3}]];
  nr = Length[RN]; m = ToString /@ br[[1]]; r = br[[2]];
  sv = spe; rv = Table["r" <> ToString[j], {j, nr}];
  ed = Join[
    Flatten[Table[If[alp[[i, j]] > 0, DirectedEdge[sv[[i]], rv[[j]]], Nothing], {i, Length[spe]}, {j, nr}]],
    Flatten[Table[If[bet[[i, j]] > 0, DirectedEdge[rv[[j]], sv[[i]]], Nothing], {i, Length[spe]}, {j, nr}]]];
  Graph[Join[sv, rv], ed,
    VertexLabels -> Join[
      (# -> Placed[Framed[#, Background -> If[MemberQ[m, #], Orange, White], FrameStyle -> Black,
          RoundingRadius -> 6, FrameMargins -> 2], Center] & /@ sv),
      Table[rv[[j]] -> Placed[Framed[Style[ToString[j], 7], Background -> If[MemberQ[r, j], RGBColor[0.55, 0.7, 1], White],
          FrameStyle -> Gray, FrameMargins -> 1], Center], {j, nr}]],
    VertexSize -> 0, BaseStyle -> {FontSize -> 8}, EdgeStyle -> Gray,
    EdgeShapeFunction -> ({Arrowheads[{{0.025, 0.65}}], Arrow[#1]} &),
    ImageSize -> 260, ImagePadding -> 10, GraphLayout -> "SpringElectricalEmbedding"]];
